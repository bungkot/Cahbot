# Copy to .env and adjust. Never commit .env.
# --- Database ---
DATABASE_URL=postgresql://rag:rag@db:5432/rag
DB_HOST=db
DB_PORT=5432
DB_NAME=rag
DB_USER=rag
DB_PASSWORD=rag

# --- LLM (llama.cpp via LangChain) ---
MODEL_PATH=/models/qwen3-1.7b-q4_k_m.gguf
LLM_THREADS=4
LLM_N_CTX=4096
LLM_N_BATCH=256
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
LLM_FLASH_ATTN=false

# --- Embeddings ---
EMBED_MODEL_PATH=/models/multilingual-e5-small.onnx
EMBED_TOKENIZER_PATH=
EMBED_DIM=384
EMBED_BATCH_SIZE=32
EMBED_MAX_SEQ_TOKENS=256
EMBED_THREADS=2

# --- Ingest worker (Sprint 2) ---
INGEST_INBOX_PATH=/data/inbox
INGEST_POLL_INTERVAL_S=2.0
INGEST_MAX_ATTEMPTS=2

# --- Retrieval ---
RETRIEVER_TOP_K=4
RRF_K=60

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=1

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LOG_LEVEL=INFO
