# Copy to .env and adjust. Never commit .env.
# --- Database ---
DATABASE_URL=postgresql://rag:rag@db:5432/rag
DB_HOST=db
DB_PORT=5432
DB_NAME=rag
DB_USER=rag
DB_PASSWORD=rag

# --- LLM (llama-cpp-python, fail GGUF lokal — offline, golden rule #2) ---
MODEL_PATH=/models/Qwen3-1.7B-Q3_K_M.gguf
LLM_THREADS=4
LLM_N_CTX=4096
LLM_N_BATCH=256
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
LLM_FLASH_ATTN=false

# --- Embeddings ---
EMBED_MODEL_PATH=/models/multilingual-e5-small.onnx
EMBED_TOKENIZER_PATH=
EMBED_DIM=384
EMBED_BATCH_SIZE=32
EMBED_MAX_SEQ_TOKENS=256
EMBED_THREADS=2

# --- Ingest worker (Sprint 2) ---
INGEST_INBOX_PATH=/data/inbox
INGEST_POLL_INTERVAL_S=2.0
INGEST_MAX_ATTEMPTS=2
# Sprint 6: rescue-scan berkala (detik) — fallback Watchdog pada mount Windows; 0 = off.
INGEST_RESCAN_INTERVAL_S=15.0

# --- Retrieval ---
RETRIEVER_TOP_K=4
RRF_K=60
HNSW_EF_SEARCH=100
CONTEXT_MAX_TOKENS=2500

# --- Chat (Sprint 4) ---
# Ambang cosine top-1 dense untuk penolakan (pilihan dari data golden — docs/eval.md).
RETRIEVAL_REFUSAL_THRESHOLD=0.82
# N mesej terakhir sejarah dimuat ke prompt (6 mesej = 3 pasangan) — KR-3.
CHAT_HISTORY_TURNS=6

# --- Auth & had kadar (Sprint 6 KR-1) ---
# Isi → semua route API (kecuali /health) perlu header `X-API-Key: <nilai>`.
# Kosong → tanpa autentikasi (dev lokal / di-container).
API_KEY=
API_KEY_HEADER=X-API-Key
# Had kadar per-sesi (permintaan/menit, sliding window in-process); 0 = matikan.
RATE_LIMIT_RPM=60

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=1

# --- Observability (optional) ---
# LANGSMITH_API_KEY=  (dibuang — bertentangan dengan offline-first)
LOG_LEVEL=INFO
