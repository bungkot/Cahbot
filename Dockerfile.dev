# syntax=docker/dockerfile:1
# Image dev-tooling: SEMUA command proyek (lint/test/e2e/eval) dijalankan di sini.
# Host Windows cukup menjalankan Docker + make.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    # Browser Playwright dijalankan sebagai root di container dev; beri sandbox
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    LANG=C.UTF-8

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc g++ cmake git curl libpq-dev \
        # kebutuhan chromium (playwright)
        fonts-liberation libasound2 libnspr4 libnss3 libx11-6 libx11-xcb1 \
        libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 \
        libxkbcommon0 libgbm1 libdrm2 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
        libcups2 libxshmfence1 libcairo2 libpango-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /uvx /bin/

# Deps proyek (manifest terlebih dahulu untuk layer cache)
ENV CMAKE_ARGS="-DGGML_NATIVE=OFF"
COPY pyproject.toml README.md ./
RUN uv pip install --system --no-cache \
        ruff mypy pytest pytest-asyncio pytest-playwright playwright \
        fastapi uvicorn pydantic-settings structlog \
        langchain-core langchain-text-splitters langchain-community \
        llama-cpp-python onnxruntime asyncpg watchdog pymupdf4llm markitdown chainlit

# Browser chromium + dependensi sistemnya
RUN playwright install --with-deps chromium

# Kode di-mount (bukan dibake) — lihat docker-compose.yml (service `dev`, profile dev)
CMD ["sleep", "infinity"]
